# Appearance
font-family                = JetBrains Mono
font-family                = Hack Nerd Font
font-size                  = 14

# Shell
shell-integration          = detect
shell-integration-features = sudo,ssh-terminfo,ssh-env

# Look and Feel
theme                      = Dracula
mouse-hide-while-typing    = true
cursor-style-blink         = false

# Behavior
confirm-close-surface            = false
clipboard-paste-protection       = false
window-inherit-working-directory = true
gtk-single-instance              = true

# Keybinds
keybind                    = ctrl+enter=unbind
keybind                    = shift+page_up=scroll_page_lines:-10
keybind                    = shift+page_down=scroll_page_lines:10
keybind                    = super+ctrl+comma=reload_config

# Selections
keybind                    = ctrl+shift+a=adjust_selection:beginning_of_line
keybind                    = ctrl+shift+e=adjust_selection:end_of_line
keybind                    = super+shift+a=select_all
keybind                    = shift+left=adjust_selection:left
keybind                    = shift+right=adjust_selection:right
keybind                    = shift+up=adjust_selection:up
keybind                    = shift+down=adjust_selection:down

## Splits
keybind                    = super+ctrl+h=goto_split:left
keybind                    = super+ctrl+j=goto_split:down
keybind                    = super+ctrl+k=goto_split:up
keybind                    = super+ctrl+l=goto_split:right
keybind                    = super+ctrl+q=new_split:right
keybind                    = super+ctrl+d=new_split:down
keybind                    = super+ctrl+f=toggle_split_zoom
keybind                    = super+ctrl+arrow_up=resize_split:up,20
keybind                    = super+ctrl+arrow_down=resize_split:down,20
keybind                    = super+ctrl+arrow_left=resize_split:left,20
keybind                    = super+ctrl+arrow_right=resize_split:right,20
keybind                    = super+ctrl+c=close_surface
