{
  "layer": "top",
  "position": "top",
  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["bluetooth", "pulseaudio", "network", "battery", "cpu", "memory"],

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },

    "format": "{capacity}% {icon}",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "tooltip-format": "{time} remaining"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },

  "network": {
    "format": "{icon}",
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "⚠ Disconnected",
    "format-alt": "{ifname} {ipaddr}/{cidr}",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "{ifname} via {gwaddr}\n{ipaddr}/{cidr}\n󰇚 {bandwidthDownBits}  󰕒 {bandwidthUpBits}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}\nfreq {frequency} GHz\n󰇚 {bandwidthDownBits}  󰕒 {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\ngw {gwaddr}\n󰇚 {bandwidthDownBits}  󰕒 {bandwidthUpBits}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "ghostty --class=com.mitchellh.ghostty-float -e nmtui",
    "on-click-right": "toggle"
  },

  "clock": {
    "format": "{:%d.%m.%y %H:%M}",
    "format-alt": "{:%a %d %b %H:%M}",
    "format-alt-click": "click-left",
    "tooltip": false
  },

  "cpu": {
    "format": "CPU {usage}%"
  },

  "memory": {
    "format": "RAM {used:0.1f}G"
  },

 "pulseaudio": {
  "format": "{icon} {volume}%",
  "format-bluetooth": "{icon}  {volume}%",
  "format-muted": "󰖁 Muted",
  "format-icons": {
    "headphone": "󰋋",
    "default": ["󰕿", "󰖀", "󰕾"]
  },

  "scroll-step": 2,
  "on-click": "pamixer -t",
  "on-click-right": "pactl set-default-sink $((s=$(pactl list short sinks | sed -e 's:^[0-9]\\+\\s\\+::' | grep -oP '^\\S+'); echo \"$s\"; echo \"$s\") | grep -F $(pactl get-default-sink) -m1 -A1 | tail -1)",
  "on-scroll-up": "pamixer -i 2",
  "on-scroll-down": "pamixer -d 2"
  },

  "sway/workspaces": {
    "tooltip": false
  }
}
